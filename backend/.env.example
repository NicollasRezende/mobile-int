# Copie para .env e ajuste.

# Token que o app Android precisa enviar para conectar.
DEVICE_TOKEN=troque-este-token

# SQLite por padrão. Para Postgres:
# DATABASE_URL=postgresql+psycopg://user:senha@localhost:5432/rfid
DATABASE_URL=sqlite:///./data/rfid.db

# Cartão desconhecido é cadastrado automaticamente (como NÃO autorizado).
# Deixe true enquanto estiver na fase de "encostar cartão e ver o que aparece".
AUTO_REGISTER_CARDS=true

# Ação devolvida ao celular
ACTION_AUTHORIZED=unlock
ACTION_DENIED=deny

LOG_LEVEL=info
